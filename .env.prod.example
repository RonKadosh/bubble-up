# Example of the runtime env file the EC2 box uses for docker-compose.prod.yml.
# In real prod this file is generated at /opt/bubbleup/.env by infra/scripts/deploy.sh,
# which pulls every secret from SSM Parameter Store at deploy time.
# Do NOT commit a real .env.prod with values.

# ─── Image tag (set by the CD workflow when calling SSM) ──────────────────
IMAGE_TAG=latest

# ─── Caddy / domain ───────────────────────────────────────────────────────
# nip.io pattern: bubbleup.<elastic-ip-with-dashes>.nip.io  (e.g. bubbleup.3-92-11-7.nip.io)
CADDY_DOMAIN=bubbleup.0-0-0-0.nip.io
CADDY_ACME_EMAIL=aamit@post.bgu.ac.il

# ─── Database ─────────────────────────────────────────────────────────────
DB_NAME=bubbleup
DB_USERNAME=bubbleup
DB_PASSWORD=__FROM_SSM__

# ─── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=__FROM_SSM__
JWT_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

# ─── Jitsi (JaaS) ─────────────────────────────────────────────────────────
APP_JITSI_APP_ID=__FROM_SSM__
APP_JITSI_KID=__FROM_SSM__
APP_JITSI_PRIVATE_KEY_PEM=__FROM_SSM__
APP_JITSI_SERVER_URL=https://8x8.vc
APP_JITSI_TOKEN_TTL=PT2H
