# Bubble.up environment example.
# Copy to `.env` (gitignored) and fill in. Used by docker-compose at the repo root.

# ─── Database ──────────────────────────────────────────────────────────────
# Defaults mirror docker-compose.yml's postgres service — usually leave as-is for local.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bubbleup
DB_USERNAME=bubbleup
DB_PASSWORD=bubbleup
# Local default resets schema on backend restart. For deploy, use update/validate
# with a managed migration plan so saved Help questions are retained.
SPRING_JPA_HIBERNATE_DDL_AUTO=create-drop

# ─── Auth ──────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ ASCII chars). Rotate before any non-local deploy.
JWT_SECRET=bubbleup-dev-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

# ─── CORS / files ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/tmp/bubbleup-files

# ─── Jitsi (JaaS) ──────────────────────────────────────────────────────────
# Bubble Room video. Get these from https://jaas.8x8.vc (free tier covers 25 MAU).
# Leave APP_JITSI_PRIVATE_KEY_PEM empty in checked-in files — paste the actual key
# only in your local .env (which is gitignored). The PEM is multi-line; preserve
# newlines as actual newlines in .env (or use literal \n if your shell prefers).
#
# APP_JITSI_KID format: <APP_ID>/<KEY_ID>  — the KEY_ID is shown in the JaaS
# console next to each API key (a short alphanumeric, e.g. b81027). COPY-PASTE
# IT — don't retype, the characters 8/a and 0/o look alike and a one-char
# typo makes JaaS reject every JWT with "Authentication failed" at join time.
APP_JITSI_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_JITSI_KID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/xxxxxx
APP_JITSI_PRIVATE_KEY_PEM=
APP_JITSI_SERVER_URL=https://8x8.vc
APP_JITSI_TOKEN_TTL=PT2H

# ─── Demo data ─────────────────────────────────────────────────────────────
# When `true`, the backend seeds 10 demo users (alice@bubble.up … jack@bubble.up,
# password Passw0rd!) split across 3 Study Bubbles on first boot. Idempotent —
# subsequent boots no-op if alice already exists. Turn OFF in any environment
# that should not have shared demo credentials.
APP_DEMO_SEED_ENABLED=true

# Optional Help Center AI assistant.
# Leave disabled for the safe local help catalog. To use OpenAI, create a key
# in the OpenAI dashboard, keep it only in `.env`, then enable this block.
APP_HELP_AI_ENABLED=false
APP_HELP_AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
APP_HELP_AI_MODEL=gpt-5-nano
APP_HELP_AI_TIMEOUT=PT20S
OPENAI_API_KEY=
