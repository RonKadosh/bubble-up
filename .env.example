# StudySync / BubbleUp environment example.
# Copy to `.env` (gitignored) and fill in. Used by docker-compose at the repo root.

# ─── Database ──────────────────────────────────────────────────────────────
# Defaults mirror docker-compose.yml's postgres service — usually leave as-is for local.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=bubbleup
DB_USERNAME=bubbleup
DB_PASSWORD=bubbleup

# ─── Auth ──────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ ASCII chars). Rotate before any non-local deploy.
JWT_SECRET=bubbleup-dev-secret-key-change-this-in-production-must-be-at-least-256-bits
JWT_ACCESS_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

# ─── CORS / files ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
FILE_STORAGE_TYPE=local
FILE_STORAGE_LOCAL_PATH=/tmp/bubbleup-files

# ─── Jitsi (JaaS) ──────────────────────────────────────────────────────────
# Bubble Room video. Get these from https://jaas.8x8.vc (free tier covers 25 MAU).
# Leave APP_JITSI_PRIVATE_KEY_PEM empty in checked-in files — paste the actual key
# only in your local .env (which is gitignored). The PEM is multi-line; preserve
# newlines as actual newlines in .env (or use literal \n if your shell prefers).
APP_JITSI_APP_ID=
APP_JITSI_KID=
APP_JITSI_PRIVATE_KEY_PEM=
APP_JITSI_SERVER_URL=https://8x8.vc
APP_JITSI_TOKEN_TTL=PT2H

# ─── Demo data ─────────────────────────────────────────────────────────────
# When `true`, the backend seeds 10 demo users (alice@bubble.up … jack@bubble.up,
# password Passw0rd!) split across 3 Study Bubbles on first boot. Idempotent —
# subsequent boots no-op if alice already exists. Turn OFF in any environment
# that should not have shared demo credentials.
APP_DEMO_SEED_ENABLED=true
